$('notesText').value=localStorage.getItem('neoWorldNotes')||'';$('saveNotes').onclick=()=>{localStorage.setItem('neoWorldNotes',$('notesText').value);$('notesStatus').textContent='Бележките са запазени.'};$('clearNotes').onclick=()=>{$('notesText').value='';localStorage.removeItem('neoWorldNotes');$('notesStatus').textContent='Бележките са изчистени.'};
let tasks=[];try{tasks=JSON.parse(localStorage.getItem('neoWorldTasks')||'[]')}catch(e){tasks=[]}function saveTasks(){localStorage.setItem('neoWorldTasks',JSON.stringify(tasks));renderTasks()}function renderTasks(){$('taskList').innerHTML='';if(!tasks.length){$('taskList').innerHTML='<p class="small">Няма добавени задачи.</p>';return}tasks.forEach((t,i)=>{let row=document.createElement('div');row.className='task'+(t.done?' done':'');let cb=document.createElement('input');cb.type='checkbox';cb.checked=t.done;cb.onchange=()=>{tasks[i].done=cb.checked;saveTasks()};let span=document.createElement('span');span.textContent=t.text;span.style.flex='1';let del=document.createElement('button');del.className='danger';del.textContent='×';del.setAttribute('aria-label','Изтрий задача');del.onclick=()=>{tasks.splice(i,1);saveTasks()};row.append(cb,span,del);$('taskList').append(row)})}
$('addTask').onclick=()=>{let v=$('taskInput').value.trim();if(!v){$('taskStatus').textContent='Напиши задача първо.';return}tasks.push({text:v,done:false});$('taskInput').value='';$('taskStatus').textContent='Задачата е добавена.';saveTasks()};$('taskInput').addEventListener('keydown',e=>{if(e.key==='Enter')$('addTask').click()});$('clearTasks').onclick=()=>{tasks=[];saveTasks();$('taskStatus').textContent='Списъкът е изчистен.'};renderTasks();
</script>
</body>
