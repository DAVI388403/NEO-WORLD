function renderBuild(){let total=0,count=0;$('sumlist').innerHTML='';catalog.forEach(p=>{let idx=chosen[p.key];$('p-'+p.key).textContent=idx===undefined?'—':euro(p.items[idx][1]);if(idx!==undefined){let it=p.items[idx];total+=it[1];count++;let li=document.createElement('li'),a=document.createElement('span'),b=document.createElement('span');a.textContent=p.name+': '+it[0];b.textContent=euro(it[1]);li.append(a,b);$('sumlist').append(li)}});if(!count)$('sumlist').innerHTML='<li><span>Няма избрани части</span><span>—</span></li>';$('total').textContent=euro(total);$('count').textContent='Избрани компоненти: '+count+' от '+catalog.length}
