<title>NEO WORLD ULTRA PRO MAX</title>
<style>
:root{--bg:#080d19;--panel:#111a2c;--panel2:#18243b;--line:#2a3b59;--text:#edf4ff;--muted:#a6b7d4;--a:#67e4ff;--b:#9a83ff;--good:#65e6a5;--bad:#ff8397;--warn:#ffd166}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#172644 0,#080d19 60%);color:var(--text);font-family:Arial,Helvetica,sans-serif;min-height:100vh}header{padding:20px 16px 16px;text-align:center;background:#080d19eF;border-bottom:1px solid var(--line)}.logo{font-weight:900;font-size:clamp(28px,5vw,44px);letter-spacing:3px;color:var(--a);text-shadow:0 0 25px #67e4ff55}.sub{color:var(--muted);margin-top:5px}nav{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;padding:12px;background:#0d1424;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}nav button{background:#18243a;color:var(--text);border:1px solid var(--line);padding:10px 13px}nav button.active{background:linear-gradient(100deg,var(--a),#9eb1ff);color:#07111e;border-color:transparent}main{max-width:1200px;margin:24px auto;padding:0 15px 50px}.page{display:none}.page.active{display:block}.hero{padding:24px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(135deg,#172743,#111a2c);margin-bottom:18px}.hero h1{font-size:clamp(26px,4vw,38px);margin:0 0 10px}.hero p{color:var(--muted);line-height:1.6;margin:0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.three{grid-template-columns:repeat(3,minmax(0,1fr))}.panel{min-width:0;background:linear-gradient(145deg,#141f34,#101729);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 15px 45px #0002}.panel h2,.panel h3{margin:0 0 10px}.muted{color:var(--muted)}.small{font-size:13px;color:var(--muted);line-height:1.5}.btn,button{font-family:inherit}button{border:0;border-radius:9px;padding:11px 14px;font-weight:700;cursor:pointer;transition:.15s}button:hover{filter:brightness(1.12);transform:translateY(-1px)}.primary{background:linear-gradient(100deg,var(--a),#9eb1ff);color:#07111e}.secondary{background:#24334f;color:var(--text);border:1px solid #3a4d6e}.danger{background:#402331;color:#ffbdca;border:1px solid #6c3548}.success{background:#163c35;color:#b4ffe0;border:1px solid #286b5a}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.actions button{flex:1}.status{min-height:20px;margin-top:10px;color:var(--a);font-size:13px;line-height:1.5}label{display:block;font-weight:700;margin:12px 0 7px}input,select,textarea{width:100%;padding:11px 12px;background:#18243a;border:1px solid #344765;border-radius:9px;color:var(--text);font:inherit;outline:none}select option{background:#18243a;color:white}textarea{resize:vertical;min-height:90px}input:focus,select:focus,textarea:focus{border-color:var(--a);box-shadow:0 0 0 3px #67e4ff1c}.partgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.part{background:#0d1526;border:1px solid var(--line);border-radius:12px;padding:12px;min-width:0}.part label{margin:0 0 8px}.category{display:block;color:var(--a);font-size:10px;letter-spacing:1px;margin-bottom:4px}.price{display:flex;justify-content:space-between;margin-top:8px;color:var(--muted);font-size:13px}.price strong{color:var(--good)}.builderlayout{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,1fr);gap:16px}.sticky{position:sticky;top:100px;align-self:start}.total{font-size:34px;font-weight:900;color:var(--good);margin:8px 0}.sumlist{list-style:none;margin:15px 0;padding:0}.sumlist li{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid #26344d;font-size:12px}.sumlist li span:first-child{color:var(--muted)}.sumlist li span:last-child{text-align:right}.notice{background:#101c2e;border:1px solid var(--line);border-radius:10px;padding:12px;margin-top:14px;color:var(--muted);font-size:13px;line-height:1.5}.question{font-size:18px;font-weight:700;line-height:1.5;margin:15px 0}.answers{display:grid;grid-template-columns:1fr 1fr;gap:9px}.answers button{text-align:left;background:#1b2942;color:var(--text);border:1px solid #344765}.answers button.correct{background:#164536;border-color:#3fbb8a}.answers button.wrong{background:#4b2533;border-color:#e76d85}.answers button:disabled{cursor:default;transform:none}.progress{height:8px;background:#202c43;border-radius:9px;overflow:hidden;margin:12px 0}.progress div{height:100%;background:linear-gradient(90deg,var(--a),var(--b));width:0;transition:width .2s}.big-number{font-size:36px;font-weight:900;color:var(--a);margin:12px 0}.gamepad{font-size:42px;text-align:center;padding:14px}.tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}.tiles button{font-size:25px;min-height:62px;background:#1b2942;color:var(--text);border:1px solid var(--line)}.tiles button.revealed{background:#263c60}.task{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}.task input{width:auto}.task.done span{text-decoration:line-through;color:var(--muted)}footer{text-align:center;color:#7588a9;font-size:12px;padding:24px 10px}@media(max-width:850px){.builderlayout{grid-template-columns:1fr}.sticky{position:static}.three{grid-template-columns:1fr 1fr}}@media(max-width:560px){nav{position:static}.grid,.three,.partgrid{grid-template-columns:1fr}.panel{padding:14px}.answers{grid-template-columns:1fr}.tiles button{min-height:52px}}
</style>
</head>
<body>
<header><div class="logo">NEO WORLD</div><div class="sub">ULTRA PRO MAX • Компютри, тестове, игри и инструменти</div></header>
<nav id="nav">
<button class="active" data-page="home">Начало</button><button data-page="builder">PC Builder</button><button data-page="doctor">PC Doctor</button><button data-page="tests">Тестове</button><button data-page="codestudio">Code Studio</button><button data-page="games">Миниигри</button><button data-page="tools">Инструменти</button><button data-page="notes">Бележки и задачи</button>
</nav>
<main>
<section id="home" class="page active">
<div class="hero"><h1>Добре дошъл в NEO WORLD</h1><p>Твоето място за сглобяване на компютър, проверка на знанията за хардуер, миниигри и полезни инструменти. Избери раздел от менюто и започни!</p></div>
<div class="grid three">
<div class="panel"><h3>🖥️ PC Builder</h3><p class="small">Избери модели за девет категории, виж ориентировъчните цени и общата сума.</p><button class="primary" onclick="showPage('builder')">Отвори билдъра</button></div>
<div class="panel"><h3>🩺 PC Doctor</h3><p class="small">Отговори на въпроси за проблеми с компютъра и основната диагностика.</p><button class="primary" onclick="showPage('doctor')">Започни диагностика</button></div>
<div class="panel"><h3>🧠 Тестове</h3><p class="small">Пет теми, три нива на трудност и разбъркани варианти на отговорите.</p><button class="primary" onclick="showPage('tests')">Към тестовете</button></div>
<div class="panel"><h3>💻 Code Studio</h3><p class="small">Генерирай готови HTML проекти за Notepad, копирай кода или го запази като .html файл.</p><button class="primary" onclick="showPage('codestudio')">Отвори Code Studio</button></div>
<div class="panel"><h3>🎮 Миниигри</h3><p class="small">Камък-ножица-хартия, математическа игра, реакция, памет, познай числото и думи.</p><button class="primary" onclick="showPage('games')">Играй</button></div>
<div class="panel"><h3>🧰 Инструменти</h3><p class="small">Калкулатор, таймер, сметач за захранване, бюджет и преобразуване на GB.</p><button class="primary" onclick="showPage('tools')">Отвори инструментите</button></div>
<div class="panel"><h3>📝 Бележки и задачи</h3><p class="small">Записвай идеи и задачи. Данните се пазят локално в браузъра.</p><button class="primary" onclick="showPage('notes')">Отвори бележките</button></div>
</div>
</section>
<section id="builder" class="page">
<div class="hero"><h1>PC Builder</h1><p>Избирай директно конкретния модел от стрелката във всяко меню. Всяка категория има отделен списък и започва с „Не е избрано“.</p></div>
<div class="builderlayout"><div class="panel"><h2>Компоненти</h2><p class="small">Цените са ориентировъчни в евро и може да се различават според магазина.</p><div class="partgrid" id="parts"></div><div class="notice">Преди покупка провери съвместимостта на сокета на процесора и дънната платка, стандарта на RAM, размерите на кутията и видеокартата, както и необходимата мощност на захранването.</div></div>
<aside class="panel sticky"><h2>Твоята конфигурация</h2><div class="small">Обща ориентировъчна цена</div><div class="total" id="total">€0,00</div><div class="small" id="count">Избрани компоненти: 0</div><ul class="sumlist" id="sumlist"><li><span>Няма избрани части</span><span>—</span></li></ul><div class="actions"><button class="primary" id="saveBuild">Запази</button><button class="secondary" id="loadBuild">Зареди</button></div><div class="actions"><button class="secondary" id="exportBuild">Експортирай .txt</button><button class="danger" id="clearBuild">Изчисти</button></div><div class="status" id="buildStatus"></div></aside></div>
</section>
<section id="doctor" class="page">
<div class="hero"><h1>PC Doctor 🩺</h1><p>Кратък образователен тест за често срещани компютърни проблеми. Това не заменя професионална диагностика. Ако компютърът мирише на изгоряло, пуши или има повреден кабел, изключи го безопасно и потърси възрастен/техник.</p></div>
<div class="panel" id="doctorBox"><div class="small">Избери най-подходящия отговор. Въпросите се разбъркват при всяко стартиране.</div><div id="doctorQuiz"></div><div class="actions"><button class="primary" id="startDoctor">Започни PC Doctor</button></div></div>
</section>
<section id="tests" class="page">
<div class="hero"><h1>Тестове по компютри</h1><p>Пет различни теми. Във всяка има поне 10 лесни, 8 средни и 5 трудни въпроса. Вариантите за отговор се разбъркват при всяко стартиране.</p></div>
<div class="panel"><div class="grid"><div><label for="testType">Вид тест</label><select id="testType"><option value="hardware">Компютърен хардуер</option><option value="software">Софтуер и операционни системи</option><option value="safety">Интернет и безопасност</option><option value="network">Мрежи и интернет</option><option value="gaming">Гейминг и производителност</option></select></div><div><label for="testLevel">Трудност</label><select id="testLevel"><option value="easy">Лесно</option><option value="medium">Средно</option><option value="hard">Трудно</option></select></div></div><div class="actions"><button class="primary" id="startTest">Започни тест</button></div><div id="testQuiz"></div></div>
</section>
<section id="codestudio" class="page">
<div class="hero"><h1>Code Studio 💻</h1><p>Генерирай готови HTML проекти, които можеш да редактираш в Notepad (Бележник) и да отвориш в браузър. Избери шаблон, промени кода, копирай го или го запази като .html файл — не ти трябва Node.js.</p></div>
<div class="grid">
<div class="panel"><h2>Генератор на проекти</h2><label for="codeTemplate">Тип проект</label><select id="codeTemplate"><option value="hello">Моята първа HTML страница</option><option value="calculator">Калкулатор</option><option value="guess">Игра „Познай числото“</option><option value="quiz">Мини тест с точки</option><option value="todo">Списък със задачи</option><option value="portfolio">Лична страница / портфолио</option><option value="clicker">Игра с кликове</option><option value="colors">Генератор на цветове</option></select>
<label for="codeProjectName">Име на проекта</label><input id="codeProjectName" value="neo-world-page" maxlength="40" placeholder="Например: moqta-stranica">
<label for="codeIdea">Текст или описание (по желание)</label><input id="codeIdea" maxlength="140" placeholder="Например: Добре дошъл в моя сайт!">
<div class="actions"><button class="primary" id="generateCode">Генерирай код</button><button class="secondary" id="resetCode">Възстанови шаблона</button></div>
<div class="notice"><strong>Как да използваш кода в Notepad:</strong><br>1. Натисни „Генерирай код“ и после „Копирай кода“ или „Изтегли .html“.<br>2. Ако копираш кода, отвори Notepad (Бележник), постави кода и избери „Файл → Запиши като…“.<br>3. Въведи име с окончание <code>.html</code> (например <code>moqt-sait.html</code>) и при „Тип файл“ избери „Всички файлове“.<br>4. Отвори запазения HTML файл с Chrome, Edge или друг браузър. Можеш да редактираш HTML, CSS и JavaScript в Notepad.</div><div class="status" id="codeStatus" aria-live="polite"></div></div>
<div class="panel"><h2>Редактор на генерирания код</h2><label for="codeOutput">HTML / CSS / JavaScript — за Notepad</label><textarea id="codeOutput" spellcheck="false" style="min-height:430px;font-family:Consolas,Monaco,monospace;font-size:13px;line-height:1.5" placeholder="Натисни „Генерирай код“…"></textarea><div class="actions"><button class="primary" id="copyCode">Копирай кода</button><button class="secondary" id="downloadCode">Изтегли .html</button></div><p class="small">Това са самостоятелни HTML файлове с вграден CSS и JavaScript. Работят в браузър и могат да бъдат отваряни и редактирани с Notepad. Можеш да променяш кода директно в полето преди копиране или изтегляне.</p></div>
</div>
</section>
<section id="games" class="page">
<div class="hero"><h1>Миниигри 🎮</h1><p>Малки игри за забавление и тренировка на ума. Избери една от картите.</p></div>
<div class="grid three">
<div class="panel"><h3>✊ Камък, ножица, хартия</h3><p class="small">Избери ход и играй срещу компютъра.</p><div class="actions"><button class="secondary" onclick="rps('Камък')">✊</button><button class="secondary" onclick="rps('Ножица')">✌️</button><button class="secondary" onclick="rps('Хартия')">✋</button></div><div class="status" id="rpsResult">Избери ход.</div><div class="small" id="rpsScore">Ти 0 — 0 Компютър</div></div>
<div class="panel"><h3>➗ Математическа игра</h3><div class="question" id="mathQ">Натисни „Нова задача“.</div><input id="mathAnswer" type="number" placeholder="Твоят отговор"><div class="actions"><button class="primary" id="mathCheck">Провери</button><button class="secondary" id="mathNew">Нова задача</button></div><div class="status" id="mathResult"></div><div class="small" id="mathScore">Точки: 0</div></div>
<div class="panel"><h3>⚡ Реакция</h3><p class="small">Натисни старт, изчакай зеленото поле и кликни възможно най-бързо.</p><button class="primary" id="reactionBtn">Започни</button><div class="big-number" id="reactionResult">—</div><div class="status" id="reactionStatus">Не натискай, преди полето да стане зелено.</div></div>
<div class="panel"><h3>🧠 Памет</h3><p class="small">Намери двойките еднакви символи.</p><div class="small" id="memoryInfo">Натисни „Нова игра“.</div><div class="tiles" id="memoryTiles"></div><div class="actions"><button class="primary" id="memoryNew">Нова игра</button></div></div>
<div class="panel"><h3>🔢 Познай числото</h3><p class="small">Компютърът е избрал число между 1 и 100.</p><input type="number" id="guessInput" min="1" max="100" placeholder="Въведи число"><div class="actions"><button class="primary" id="guessBtn">Познай</button><button class="secondary" id="guessNew">Ново число</button></div><div class="status" id="guessResult">Имаш неограничени опити.</div></div>
<div class="panel"><h3>🔤 Познай думата</h3><p class="small">Разбъркани букви — познай думата, свързана с компютрите.</p><div class="big-number" id="wordMix">—</div><input id="wordAnswer" placeholder="Твоята дума"><div class="actions"><button class="primary" id="wordCheck">Провери</button><button class="secondary" id="wordNew">Нова дума</button></div><div class="status" id="wordResult"></div></div>
</div>
</section>
<section id="tools" class="page">
<div class="hero"><h1>Инструменти 🧰</h1><p>Полезни калкулации и малки помощници, които работят директно в браузъра.</p></div>
<div class="grid">
<div class="panel"><h2>Калкулатор</h2><label for="calcExpr">Израз</label><input id="calcExpr" placeholder="Например: (25 + 15) * 2"><div class="actions"><button class="primary" id="calcBtn">Изчисли</button><button class="secondary" id="calcClear">Изчисти</button></div><div class="big-number" id="calcResult">—</div><div class="small">Поддържа числа, +, −, ×, ÷, скоби и десетична точка.</div></div>
<div class="panel"><h2>Таймер</h2><label for="timerSeconds">Секунди</label><input id="timerSeconds" type="number" min="1" max="86400" value="60"><div class="big-number" id="timerDisplay">01:00</div><div class="actions"><button class="primary" id="timerStart">Старт</button><button class="secondary" id="timerPause">Пауза</button><button class="secondary" id="timerReset">Нулирай</button></div><div class="status" id="timerStatus"></div></div>
<div class="panel"><h2>Калкулатор за захранване</h2><label for="gpuW">Ориентировъчна мощност на видеокартата (W)</label><input id="gpuW" type="number" min="0" value="220"><label for="cpuW">Ориентировъчна мощност на процесора (W)</label><input id="cpuW" type="number" min="0" value="100"><label for="otherW">Останали компоненти (W)</label><input id="otherW" type="number" min="0" value="80"><div class="actions"><button class="primary" id="psuCalc">Изчисли препоръка</button></div><div class="big-number" id="psuResult">—</div><div class="small">Приблизителна оценка с резерв; не е гаранция за съвместимост или реално потребление.</div></div>
<div class="panel"><h2>Бюджет за компютър</h2><label for="budget">Твоят бюджет (€)</label><input id="budget" type="number" min="0" value="1000"><label for="spent">Цена на избраните части (€)</label><input id="spent" type="number" min="0" value="0"><div class="actions"><button class="primary" id="budgetCalc">Сметни остатъка</button></div><div class="big-number" id="budgetResult">—</div><div class="status" id="budgetStatus"></div><button class="secondary" id="useBuildBudget">Вземи сумата от PC Builder</button></div>
<div class="panel"><h2>Преобразуване на памет</h2><label for="gbInput">Количество в GB</label><input id="gbInput" type="number" min="0" value="16"><div class="actions"><button class="primary" id="convertGB">Преобразувай</button></div><div class="status" id="gbResult">16 GB = 16 000 MB (десетично) ≈ 16 384 MiB (двоично).</div></div>
<div class="panel"><h2>Сравнение на два компонента</h2><label for="compareA">Компонент A</label><select id="compareA"></select><label for="compareB">Компонент B</label><select id="compareB"></select><div class="actions"><button class="primary" id="compareBtn">Сравни цените</button></div><div class="status" id="compareResult"></div></div>
</div>
</section>
<section id="notes" class="page">
<div class="hero"><h1>Бележки и задачи 📝</h1><p>Записвай идеи, списъци и неща за проверка. Запазването е локално в този браузър.</p></div>
<div class="grid">
<div class="panel"><h2>Бележник</h2><label for="notesText">Твоите бележки</label><textarea id="notesText" placeholder="Запиши идея за компютър, компоненти или нещо важно..."></textarea><div class="actions"><button class="primary" id="saveNotes">Запази бележките</button><button class="secondary" id="clearNotes">Изчисти</button></div><div class="status" id="notesStatus"></div></div>
<div class="panel"><h2>Списък със задачи</h2><label for="taskInput">Нова задача</label><input id="taskInput" placeholder="Например: сравни видеокарти"><div class="actions"><button class="primary" id="addTask">Добави задача</button><button class="secondary" id="clearTasks">Изчисти списъка</button></div><div id="taskList"></div><div class="status" id="taskStatus"></div></div>
</div>
</section>
</main>
<footer>NEO WORLD • Един HTML файл • Данните се пазят локално на устройството</footer>
<script>
const $=id=>document.getElementById(id);
function showPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===id));document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===id));window.scrollTo({top:0,behavior:'smooth'})}
